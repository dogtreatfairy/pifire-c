        "enabled": true,
        "select": {
          "domain": "grill",
          "match": "any"
        },
        "when": {
          "op": "all",
          "conditions": [
            {
              "entity": "grill",
              "trait": "mode",
              "op": "is",
              "value": "Hold"
            },
            {
              "entity": "grill",
              "trait": "over",
