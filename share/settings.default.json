              "value": -20
            },
            {
              "entity": "grill",
              "trait": "aiming_s",
              "op": ">",
              "value": 1200
            }
          ]
        },
        "title": "{grill} is not getting there",
        "body": "Still {grill_temp} against a {setpoint} target, twenty minutes after being asked for it. Check the fire and the hopper.",
        "level": "high",
        "sinks": [
          "app",
          "webpush",
          "pushover",
          "ntfy"
        ],
        "for_s": 120,
        "cooldown_s": 900,
        "repeat_s": 0,
        "only_while_cooking": true,
        "deadband": 3
      },
      {
        "id": "hopper-low",
        "name": "Hopper Low",
        "enabled": true,
        "select": {
          "domain": "hopper",
          "match": "any"
        },
