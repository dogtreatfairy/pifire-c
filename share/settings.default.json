        "sinks": [
          "app",
          "webpush",
          "pushover"
        ],
        "cooldown_s": 21600,
        "repeat_s": 0,
        "for_s": 10,
        "only_while_cooking": true
      },
      {
        "id": "grill-at-temp",
        "name": "Grill Reached Temp",
        "enabled": true,
        "select": {
          "domain": "grill",
          "match": "any"
        },
        "when": {
          "op": "any",
          "conditions": [
            {
              "op": "all",
              "conditions": [
                {
                  "entity": "grill",
                  "trait": "mode",
                  "op": "is",
                  "value": "Hold"
                },
                {
                  "entity": "grill",
                  "trait": "over",
                  "op": "within",
                  "value": 0,
                  "value2": 15
                }
              ]
            },
            {
              "op": "all",
              "conditions": [
                {
                  "entity": "grill",
                  "trait": "mode",
                  "op": "is",
                  "value": "Smoke"
                },
                {
                  "entity": "grill",
                  "trait": "temp",
                  "op": "between",
                  "value": 180,
                  "value2": 230
                }
              ]
            }
          ]
        },
        "title": "{grill} is up to temperature",
        "body": "The pit is at {grill_temp}.",
        "level": "normal",
        "sinks": [
          "app",
          "webpush",
          "pushover",
          "ntfy"
        ],
        "for_s": 180,
        "cooldown_s": 1800,
        "repeat_s": 0,
        "only_while_cooking": true
      },
      {
        "id": "grill-hot",
        "name": "Grill Stalled Hot",
