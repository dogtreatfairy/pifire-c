[Unit]
Description=PiFire pellet grill controller
# Never give up restarting: every start switches the outputs off first, and a daemon systemd has
# stopped trying to run is one nobody is watching the fire for.
StartLimitIntervalSec=0
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/pifired
# After every stop, a crash or a kill included: a GPIO line keeps its level when the daemon dies, so
# the relays are driven off from outside it before anything else happens.
ExecStopPost=/usr/local/bin/pifired --outputs-off
Restart=always
RestartSec=2
WatchdogSec=15
User=pifire
Group=pifire
SupplementaryGroups=gpio i2c spi dialout netdev bluetooth
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
# sudo is used for the whitelisted helpers in /etc/sudoers.d/pifire (boot config, OTA apply, reboot),
# so NoNewPrivileges/ProtectSystem cannot be enabled here.
ReadWritePaths=/etc/pifire /var/lib/pifire
StateDirectory=pifire
ConfigurationDirectory=pifire

[Install]
WantedBy=multi-user.target
